# Use a long, randomly generated secret; never commit the actual .env file.
PAYLOAD_SECRET=
# sqlite is for local development; production requires postgres.
PAYLOAD_DATABASE=sqlite
# Optional local SQLite file; leave empty to use .local/payload.sqlite.
PAYLOAD_SQLITE_URL=
# Persistent upload directory for production media; local default is .local/media.
PAYLOAD_MEDIA_DIR=
# Optional backup output directory and PostgreSQL binary overrides.
BACKUP_DIR=.local/backups
# PG_DUMP_BIN=
# PG_RESTORE_BIN=
# Required for postgres; do not place real credentials in this example.
DATABASE_URL=
# sample keeps the current prototype data; payload reads from the configured CMS.
CATALOG_SOURCE=sample
CROP_GUIDE_SOURCE=sample
# Keep the prototype status strip hidden during visual comparison; set to 1 for internal review.
SHOW_PREVIEW_BANNER=0
# Local default is disabled; production is enabled by the owner-approved configuration.
# No SMTP/API notification adapter is configured; success means the inquiry was stored.
INQUIRY_MODE=disabled
