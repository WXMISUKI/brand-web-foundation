# ---- Public Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Brand
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR

# ---- CMS / Admin (Payload) ----
CMS_URL=http://localhost:3001
PAYLOAD_SECRET=a-random-secret-change-me-in-production
DATABASE_URI=file:./data/payload.db

# ---- CMS Admin Initial Seed ----
# Set these before initial startup to seed the first admin user
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=your-secure-password-here

# ---- Analytics ----
NEXT_PUBLIC_ANALYTICS_ID=
ANALYTICS_PROVIDER=none

# ---- External Integrations (adapter-driven, do not hardcode) ----
# TELEGRAM_BOT_TOKEN=
# WHATSAPP_API_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# PAYMENT_GATEWAY_KEY=
